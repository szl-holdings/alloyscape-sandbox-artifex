@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
@import "tailwindcss";

@theme inline {
  --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;

  --color-background: 40 33% 96%;
  --color-foreground: 30 18% 18%;

  --color-card: 0 0% 100%;
  --color-card-foreground: 30 18% 18%;

  --color-popover: 0 0% 100%;
  --color-popover-foreground: 30 18% 18%;

  --color-primary: 174 55% 32%;
  --color-primary-foreground: 0 0% 100%;

  --color-secondary: 38 30% 90%;
  --color-secondary-foreground: 30 18% 18%;

  --color-muted: 38 24% 88%;
  --color-muted-foreground: 30 10% 40%;

  --color-accent: 24 90% 48%;
  --color-accent-foreground: 0 0% 100%;

  --color-destructive: 0 70% 45%;
  --color-destructive-foreground: 0 0% 100%;

  --color-border: 35 20% 82%;
  --color-input: 35 20% 82%;
  --color-ring: 174 55% 32%;
}

:root {
  --background: 40 33% 96%;
  --foreground: 30 18% 18%;
  --card: 0 0% 100%;
  --card-foreground: 30 18% 18%;
  --popover: 0 0% 100%;
  --popover-foreground: 30 18% 18%;
  --primary: 174 55% 32%;
  --primary-foreground: 0 0% 100%;
  --secondary: 38 30% 90%;
  --secondary-foreground: 30 18% 18%;
  --muted: 38 24% 88%;
  --muted-foreground: 30 10% 40%;
  --accent: 24 90% 48%;
  --accent-foreground: 0 0% 100%;
  --destructive: 0 70% 45%;
  --destructive-foreground: 0 0% 100%;
  --border: 35 20% 82%;
  --input: 35 20% 82%;
  --ring: 174 55% 32%;
  --radius: 0.5rem;
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    background-color: #f6f1e7;
    background-image:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(24, 144, 138, 0.10), transparent),
      radial-gradient(ellipse 60% 60% at 80% 100%, rgba(214, 158, 110, 0.12), transparent),
      linear-gradient(180deg, #f8f4ec 0%, #f3ede1 50%, #efe7d8 100%);
    background-attachment: fixed;
    min-height: 100vh;
    color: #2e2a22;
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  ::selection {
    background: rgba(24, 144, 138, 0.25);
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: #1f1c16;
  }
}

@layer utilities {
  .glass-panel {
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(40px) saturate(1.2);
    -webkit-backdrop-filter: blur(40px) saturate(1.2);
    border: 1px solid rgba(120, 100, 70, 0.14);
    box-shadow:
      0 8px 32px 0 rgba(120, 100, 70, 0.12),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.7);
  }
  .glass-card {
    background: rgba(255, 255, 255, 0.66);
    backdrop-filter: blur(40px) saturate(1.2);
    -webkit-backdrop-filter: blur(40px) saturate(1.2);
    border: 1px solid rgba(120, 100, 70, 0.14);
    box-shadow:
      0 8px 32px 0 rgba(120, 100, 70, 0.12),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.7);
  }
  .glass-card:hover {
    border-color: rgba(24, 144, 138, 0.30);
    box-shadow:
      0 10px 36px 0 rgba(120, 100, 70, 0.16),
      0 0 0 1px rgba(24, 144, 138, 0.10),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.8);
  }
  .glass-nav {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(40px) saturate(1.3);
    -webkit-backdrop-filter: blur(40px) saturate(1.3);
    border-bottom: 1px solid rgba(120, 100, 70, 0.14);
    box-shadow: 0 4px 30px rgba(120, 100, 70, 0.10);
  }
  .glass-sidebar {
    background: rgba(255, 255, 255, 0.68);
    backdrop-filter: blur(40px) saturate(1.2);
    -webkit-backdrop-filter: blur(40px) saturate(1.2);
    border-right: 1px solid rgba(120, 100, 70, 0.14);
  }
  .glass-input {
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(120, 100, 70, 0.16);
  }

  .neon-cyan {
    color: #146e64;
  }
  .text-glow {
    text-shadow: none;
  }
  .box-glow {
    box-shadow: 0 0 18px rgba(24, 144, 138, 0.18);
  }
  .box-glow-purple {
    box-shadow: 0 0 18px rgba(214, 158, 110, 0.18);
  }
  .box-glow-green {
    box-shadow: 0 0 18px rgba(24, 144, 138, 0.18);
  }
  .cyan-glow-hover:hover {
    box-shadow: 0 0 22px rgba(24, 144, 138, 0.28);
    border-color: rgba(24, 144, 138, 0.30);
  }
  .brain-glow {
    animation: brainPulse 3s ease-in-out infinite;
  }
  .mic-recording {
    animation: micPulse 1s ease-in-out infinite;
  }
  .engine-badge {
    background: rgba(255, 255, 255, 0.70);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(24, 144, 138, 0.25);
    color: #146e64;
  }

  .liquid-glass {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.78) 0%,
      rgba(255, 255, 255, 0.62) 50%,
      rgba(255, 255, 255, 0.70) 100%
    );
    backdrop-filter: blur(60px) saturate(1.4) brightness(1.02);
    -webkit-backdrop-filter: blur(60px) saturate(1.4) brightness(1.02);
    border: 1px solid rgba(120, 100, 70, 0.18);
    box-shadow:
      0 8px 32px rgba(120, 100, 70, 0.14),
      0 2px 8px rgba(120, 100, 70, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(120, 100, 70, 0.06);
    position: relative;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1),
                box-shadow 0.4s cubic-bezier(0.23, 1, 0.32, 1),
                border-color 0.4s ease;
  }
  .liquid-glass::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.6) 30%,
      rgba(255, 255, 255, 0.8) 50%,
      rgba(255, 255, 255, 0.6) 70%,
      transparent 100%
    );
    pointer-events: none;
  }
  .liquid-glass:hover {
    transform: translateY(-3px) scale(1.005);
    border-color: rgba(24, 144, 138, 0.30);
    box-shadow:
      0 16px 48px rgba(120, 100, 70, 0.18),
      0 4px 12px rgba(120, 100, 70, 0.12),
      0 0 0 1px rgba(24, 144, 138, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(120, 100, 70, 0.06);
  }
  .liquid-glass-depth {
    background: linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.58) 40%,
      rgba(244, 238, 226, 0.70) 100%
    );
    backdrop-filter: blur(80px) saturate(1.6) brightness(1.01);
    -webkit-backdrop-filter: blur(80px) saturate(1.6) brightness(1.01);
    border: 1px solid rgba(120, 100, 70, 0.16);
    box-shadow:
      0 12px 40px rgba(120, 100, 70, 0.16),
      0 4px 16px rgba(120, 100, 70, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
  }
  .liquid-shimmer {
    position: relative;
    overflow: hidden;
  }
  .liquid-shimmer::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      ellipse at 30% 20%,
      rgba(255, 255, 255, 0.5) 0%,
      transparent 60%
    );
    pointer-events: none;
    transition: opacity 0.5s ease;
    opacity: 0;
  }
  .liquid-shimmer:hover::after {
    opacity: 1;
  }
}

@keyframes brainPulse {
  0%, 100% {
    box-shadow: 0 0 10px rgba(24, 144, 138, 0.18), 0 0 30px rgba(24, 144, 138, 0.10);
    filter: brightness(1);
  }
  50% {
    box-shadow: 0 0 25px rgba(24, 144, 138, 0.30), 0 0 50px rgba(24, 144, 138, 0.16);
    filter: brightness(1.05);
  }
}

@keyframes micPulse {
  0%, 100% {
    box-shadow: 0 0 8px rgba(220, 90, 70, 0.30);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 20px rgba(220, 90, 70, 0.55);
    transform: scale(1.05);
  }
}

::-webkit-scrollbar {
  width: 5px;
  height: 5px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(120, 100, 70, 0.30);
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(120, 100, 70, 0.45);
}

.scrollbar-hide {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.scrollbar-hide::-webkit-scrollbar {
  display: none;
}

.chat-markdown p {
  margin-bottom: 0.5rem;
}
.chat-markdown p:last-child {
  margin-bottom: 0;
}
.chat-markdown .chat-h2 {
  font-size: 1rem;
  font-weight: 700;
  color: #1f1c16;
  margin: 0.75rem 0 0.375rem;
}
.chat-markdown .chat-h3 {
  font-size: 0.875rem;
  font-weight: 600;
  color: #2e2a22;
  margin: 0.625rem 0 0.25rem;
}
.chat-markdown .chat-h4 {
  font-size: 0.8125rem;
  font-weight: 600;
  color: #146e64;
  margin: 0.5rem 0 0.25rem;
}
.chat-markdown .chat-ul,
.chat-markdown .chat-ol {
  padding-left: 1.25rem;
  margin: 0.375rem 0;
}
.chat-markdown .chat-li {
  list-style-type: disc;
  margin-bottom: 0.125rem;
  color: #2e2a22;
}
.chat-markdown .chat-oli {
  list-style-type: decimal;
  margin-bottom: 0.125rem;
  color: #2e2a22;
}
.chat-markdown .chat-quote {
  border-left: 2px solid rgba(24, 144, 138, 0.40);
  padding-left: 0.75rem;
  margin: 0.5rem 0;
  color: #4a4438;
  font-style: italic;
}
.chat-markdown .chat-hr {
  border: none;
  border-top: 1px solid rgba(120, 100, 70, 0.25);
  margin: 0.75rem 0;
}
.chat-markdown strong {
  color: #1f1c16;
  font-weight: 600;
}
.chat-markdown em {
  color: #4a4438;
}
.chat-markdown .inline-code {
  background: rgba(24, 144, 138, 0.10);
  border: 1px solid rgba(24, 144, 138, 0.22);
  border-radius: 4px;
  padding: 0.125rem 0.375rem;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.75rem;
  color: #146e64;
}
.chat-markdown .code-block {
  position: relative;
  margin: 0.5rem 0;
  border-radius: 0.75rem;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.70);
  border: 1px solid rgba(120, 100, 70, 0.18);
  max-width: 100%;
  box-sizing: border-box;
}
.chat-markdown .code-block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.25rem 0.75rem;
  background: rgba(255, 255, 255, 0.55);
  border-bottom: 1px solid rgba(120, 100, 70, 0.14);
  min-height: 1.75rem;
}
.chat-markdown .code-block .code-lang {
  font-size: 0.625rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: rgba(20, 110, 100, 0.75);
}
.chat-markdown .code-copy-btn {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  z-index: 5;
  font-size: 0.625rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #146e64;
  background: rgba(24, 144, 138, 0.12);
  border: 1px solid rgba(24, 144, 138, 0.35);
  border-radius: 6px;
  padding: 0.25rem 0.5rem;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s, background 0.15s, transform 0.1s;
  line-height: 1.4;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}
.chat-markdown .code-copy-btn::before {
  content: "\26c9";
  font-size: 0.875rem;
  line-height: 1;
}
.chat-markdown .code-copy-btn:hover {
  color: #0f564d;
  border-color: rgba(24, 144, 138, 0.6);
  background: rgba(24, 144, 138, 0.20);
  transform: scale(1.05);
}
.chat-markdown .code-copy-btn:active {
  transform: scale(0.95);
}
.chat-markdown .code-copy-btn.copied {
  color: #0f564d;
  border-color: rgba(24, 144, 138, 0.55);
}
.chat-markdown .code-block pre {
  padding: 0.75rem;
  overflow-x: auto;
  margin: 0;
  max-width: 100%;
}
.chat-markdown .code-block code {
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.75rem;
  line-height: 1.5;
  color: #2e2a22;
  white-space: pre;
  word-break: normal;
  display: block;
}
